// Prisma schema for VELORA catalog — PostgreSQL
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameAr        String
  description   String
  descriptionAr String
  tagline       String
  taglineAr     String
  sortOrder     Int       @default(0)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id             String   @id // keep stable ids like p1 for advisor tools
  slug           String   @unique
  name           String
  nameAr         String
  categorySlug   String
  category       Category @relation(fields: [categorySlug], references: [slug])
  price          Int
  /// نسبة الخصم من السعر الأساسي: 0 | 10 | 20 | 30 | 40 | 50
  discountPercent Int     @default(0)
  currency       String   @default("IQD")
  description    String
  descriptionAr  String
  /// مصفوفات JSON أصلية في PostgreSQL (كانت نصاً في SQLite)
  benefitsJson   Json
  benefitsArJson Json
  ingredientsJson Json
  concernsJson   Json
  size           String
  isBestseller   Boolean  @default(false)
  isNew          Boolean  @default(false)
  rating         Float    @default(0)
  reviews        Int      @default(0)
  imageTone      String
  imageUrl       String?
  stock          Int      @default(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  wishlistItems  CustomerWishlistItem[]

  @@index([categorySlug])
  @@index([isActive, isBestseller])
}

/// فروع VELORA (الدوام)
model Branch {
  id        String     @id @default(cuid())
  name      String
  city      String     @default("")
  address   String     @default("")
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@index([isActive, sortOrder])
}

/// موظف في متجر VELORA — للوحة الإدارة (حضور ورواتب وتسجيل دخول)
model Employee {
  id           String    @id @default(cuid())
  name         String
  phone        String    @default("")
  /// الدور: manager | cashier | warehouse | delivery | advisor | other
  role         String    @default("other")
  /// الراتب الأساسي الشهري بالدينار العراقي
  baseSalary   Int       @default(0)
  hireDate     String
  isActive     Boolean   @default(true)
  notes        String    @default("")
  /// اسم مستخدم لتسجيل الدخول إلى لوحة الإدارة (اختياري)
  username     String?   @unique
  /// كلمة المرور مشفّرة PBKDF2 — لا تُعاد للواجهة أبداً
  passwordHash String?
  /// آخر نشاط داخل لوحة الإدارة (لمؤشر «نشط على الموقع»)
  lastSeenAt   DateTime?
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendances Attendance[]
  salaryItems SalaryItem[]

  @@index([isActive, role])
  @@index([branchId])
  @@index([lastSeenAt])
}

/// سجل حضور يومي لموظف
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// تاريخ بصيغة YYYY-MM-DD
  date       String
  /// present | absent | late | leave | half
  status     String   @default("present")
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
}

/// سلفة أو مكافأة أو خصم مرتبط بشهر راتب
model SalaryItem {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  monthKey   String
  /// advance | bonus | deduction
  type       String
  amount     Int
  reason     String   @default("")
  date       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, monthKey])
  @@index([monthKey])
}

/// زبون المتجر — حساب تسجيل الدخول
model Customer {
  id            String                 @id @default(cuid())
  email         String                 @unique
  /// اختياري لحسابات Google / Apple
  passwordHash  String?
  fullName      String
  /// جوال عراقي بصيغة 9647XXXXXXXXX — اختياري عند الدخول عبر OAuth
  phone         String?                @unique
  phoneVerified Boolean                @default(false)
  address       String                 @default("")
  /// معرّف Google (sub) إن وُجد
  googleId      String?                @unique
  /// معرّف Apple (sub) إن وُجد
  appleId       String?                @unique
  /// password | google | apple | linked
  authProvider  String                 @default("password")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  wishlistItems CustomerWishlistItem[]
}

/// منتجات محفوظة في قائمة أمنيات الزبون (بدون تكرار)
model CustomerWishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
}

/// رموز تحقق رقم الهاتف (OTP)
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// طلبات المتجر — تُحفظ في PostgreSQL (لا يعمل تخزين الملفات على Vercel)
model Order {
  id            String    @id
  subject       String
  emailedTo     String?
  /// new | confirmed | preparing | ready_to_ship | handed_to_courier | in_transit | out_for_delivery | delivered | deferred | cancelled | returned | failed_delivery
  status        String    @default("new")
  /// OrderPayload كاملاً كـ JSON
  orderJson     Json
  text          String    @default("")
  adminNote     String?
  receiptSentAt DateTime?
  savedAt       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, savedAt])
  @@index([savedAt])
}
