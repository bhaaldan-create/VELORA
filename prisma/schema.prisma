// Prisma schema for VELORA catalog — PostgreSQL
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameAr        String
  description   String
  descriptionAr String
  tagline       String
  taglineAr     String
  sortOrder     Int       @default(0)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id             String   @id // keep stable ids like p1 for advisor tools
  slug           String   @unique
  name           String
  nameAr         String
  categorySlug   String
  category       Category @relation(fields: [categorySlug], references: [slug])
  price          Int
  /// نسبة الخصم من السعر الأساسي: 0 | 10 | 20 | 30 | 40 | 50
  discountPercent Int     @default(0)
  currency       String   @default("IQD")
  description    String
  descriptionAr  String
  /// مصفوفات JSON أصلية في PostgreSQL (كانت نصاً في SQLite)
  benefitsJson   Json
  benefitsArJson Json
  ingredientsJson Json
  concernsJson   Json
  size           String
  isBestseller   Boolean  @default(false)
  isNew          Boolean  @default(false)
  rating         Float    @default(0)
  reviews        Int      @default(0)
  imageTone      String
  imageUrl       String?
  /// اسم العلامة التجارية للمصنّع (اختياري) — ليس شعار VELORA
  brandName      String?
  /// شعار العلامة التجارية للمصنّع (اختياري)
  brandLogoUrl   String?
  stock          Int      @default(100)
  isActive       Boolean  @default(true)

  /// —— Product cost / landed cost (IQD cents not used — whole IQD / USD units) ——
  supplierId           String?
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Purchase currency for unit cost: IQD | USD
  costCurrency         String    @default("IQD")
  /// Exchange rate used: 1 costCurrency unit → IQD (1 when IQD)
  costExchangeRate     Float     @default(1)
  /// Unit purchase price in costCurrency
  purchasePrice        Float     @default(0)
  /// Allocated import extras per unit, already in IQD
  shippingCostIqd      Float     @default(0)
  customsCostIqd       Float     @default(0)
  brokerageCostIqd     Float     @default(0)
  handlingCostIqd      Float     @default(0)
  otherCostIqd         Float     @default(0)
  /// Cached: purchasePrice*rate + extras (IQD). 0 means unknown/not set when purchasePrice=0
  landedCostIqd        Float     @default(0)
  /// Minimum acceptable gross margin % (e.g. 25)
  minMarginPct         Float     @default(20)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  wishlistItems  CustomerWishlistItem[]
  importItems    ImportItem[]
  inventoryMoves InventoryMovement[]

  @@index([categorySlug])
  @@index([isActive, isBestseller])
  @@index([supplierId])
  @@index([brandName])
}

/// فروع VELORA (الدوام)
model Branch {
  id        String     @id @default(cuid())
  name      String
  city      String     @default("")
  address   String     @default("")
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@index([isActive, sortOrder])
}

/// موظف في متجر VELORA — للوحة الإدارة (حضور ورواتب وتسجيل دخول)
model Employee {
  id           String    @id @default(cuid())
  name         String
  phone        String    @default("")
  /// الدور: manager | cashier | warehouse | delivery | advisor | other
  role         String    @default("other")
  /// الراتب الأساسي الشهري بالدينار العراقي
  baseSalary   Int       @default(0)
  hireDate     String
  isActive     Boolean   @default(true)
  notes        String    @default("")
  /// اسم مستخدم لتسجيل الدخول إلى لوحة الإدارة (اختياري)
  username     String?   @unique
  /// كلمة المرور مشفّرة PBKDF2 — لا تُعاد للواجهة أبداً
  passwordHash String?
  /// آخر نشاط داخل لوحة الإدارة (لمؤشر «نشط على الموقع»)
  lastSeenAt   DateTime?
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendances Attendance[]
  salaryItems SalaryItem[]

  @@index([isActive, role])
  @@index([branchId])
  @@index([lastSeenAt])
}

/// سجل حضور يومي لموظف
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// تاريخ بصيغة YYYY-MM-DD
  date       String
  /// present | absent | late | leave | half
  status     String   @default("present")
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
}

/// سلفة أو مكافأة أو خصم مرتبط بشهر راتب
model SalaryItem {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  monthKey   String
  /// advance | bonus | deduction
  type       String
  amount     Int
  reason     String   @default("")
  date       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, monthKey])
  @@index([monthKey])
}

/// زبون المتجر — حساب تسجيل الدخول
model Customer {
  id            String                 @id @default(cuid())
  email         String                 @unique
  /// اختياري لحسابات Google / Apple
  passwordHash  String?
  fullName      String
  /// جوال عراقي بصيغة 9647XXXXXXXXX — اختياري عند الدخول عبر OAuth
  phone         String?                @unique
  phoneVerified Boolean                @default(false)
  address       String                 @default("")
  /// معرّف Google (sub) إن وُجد
  googleId      String?                @unique
  /// معرّف Apple (sub) إن وُجد
  appleId       String?                @unique
  /// password | google | apple | linked
  authProvider  String                 @default("password")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  wishlistItems CustomerWishlistItem[]
  notifications CustomerNotification[]
  veloraCards   VeloraCard[]
  achievements  VeloraAchievement[]
  referralLinks VeloraReferralLink[]
}

/// منتجات محفوظة في قائمة أمنيات الزبون (بدون تكرار)
model CustomerWishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@index([productId])
}

/// رموز تحقق رقم الهاتف (OTP)
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// إعدادات برنامج VELORA Beauty Club (JSON قابل للتعديل من الأدمن)
model ClubProgramConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// إعدادات هيرو الصفحة الرئيسية (شرائح + صور قابلة للتعديل من الأدمن)
model HomeHeroConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// بطاقات «تسوق حسب الفئة» على الصفحة الرئيسية
model HomeCategoryConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// بانر «وصل حديثاً» على الصفحة الرئيسية
model HomePromoConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// تعميم إشعار من الأدمن إلى الزبائن
model NotificationCampaign {
  id         String                 @id @default(cuid())
  titleAr    String
  bodyAr     String
  titleEn    String?
  bodyEn     String?
  href       String?
  createdBy  String?
  createdAt  DateTime               @default(now())
  recipients CustomerNotification[]

  @@index([createdAt])
}

/// إشعار في صندوق الزبونة
model CustomerNotification {
  id         String                @id @default(cuid())
  customerId String
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  titleAr    String
  bodyAr     String
  titleEn    String?
  bodyEn     String?
  href       String?
  readAt     DateTime?
  createdAt  DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([customerId, readAt])
  @@index([campaignId])
}

/// طلبات المتجر — تُحفظ في PostgreSQL (لا يعمل تخزين الملفات على Vercel)
model Order {
  id            String    @id
  subject       String
  emailedTo     String?
  /// new | confirmed | preparing | ready_to_ship | handed_to_courier | in_transit | out_for_delivery | delivered | deferred | cancelled | returned | failed_delivery
  status        String    @default("new")
  /// OrderPayload كاملاً كـ JSON
  orderJson     Json
  text          String    @default("")
  adminNote     String?
  receiptSentAt DateTime?
  savedAt       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, savedAt])
  @@index([savedAt])
}

/// —— VELORA Business OS: suppliers, imports, finance, insights ——

model Supplier {
  id                String   @id @default(cuid())
  name              String
  country           String   @default("")
  website           String   @default("")
  catalogUrl        String   @default("")
  contactName       String   @default("")
  contactPhone      String   @default("")
  contactEmail      String   @default("")
  whatsappUrl       String   @default("")
  instagramUrl      String   @default("")
  alibabaUrl        String   @default("")
  otherLinksJson    Json     @default("[]")
  currency          String   @default("USD")
  paymentTerms      String   @default("")
  shippingMethod    String   @default("")
  /// 1–5
  reliabilityRating Int      @default(3)
  avgDeliveryDays   Int      @default(0)
  notes             String   @default("")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products  Product[]
  shipments ImportShipment[]
  brands    BrandProfile[]

  @@index([isActive, name])
}

/// Brand intelligence layer (linked by name to Product.brandName)
model BrandProfile {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  countryOfOrigin String    @default("")
  officialWebsite String    @default("")
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sourceCountry   String    @default("")
  currency        String    @default("USD")
  notes           String    @default("")
  documentsJson   Json      @default("[]")
  linksJson       Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([supplierId])
  @@index([name])
}

model ImportShipment {
  id              String   @id @default(cuid())
  /// Human-readable code e.g. IMP-2026-001
  code            String   @unique
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Planned | Ordered | Paid | Shipped | InTransit | Arrived | Received | Completed
  status          String   @default("Planned")
  currency        String   @default("USD")
  exchangeRate    Float    @default(1)
  purchaseDate    String   @default("")
  shippingDate    String   @default("")
  arrivalDate     String   @default("")
  receivedDate    String   @default("")
  trackingNumber  String   @default("")
  /// Totals in shipment currency (before converting)
  purchaseTotal   Float    @default(0)
  shippingCost    Float    @default(0)
  customsCost     Float    @default(0)
  brokerageCost   Float    @default(0)
  otherFees       Float    @default(0)
  /// Cached total landed IQD
  totalLandedIqd  Float    @default(0)
  notes           String   @default("")
  documentsJson   Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items ImportItem[]

  @@index([status, createdAt])
  @@index([supplierId])
}

model ImportItem {
  id           String         @id @default(cuid())
  shipmentId   String
  shipment     ImportShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int            @default(1)
  /// Unit purchase in shipment currency
  unitCost     Float          @default(0)
  /// Allocated landed cost per unit in IQD (after receive)
  landedUnitIqd Float         @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([shipmentId])
  @@index([productId])
}

model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// receive | adjust | sale_commit | return | write_off
  type        String
  quantity    Int
  /// Stock after this movement
  balanceAfter Int
  reference   String   @default("")
  note        String   @default("")
  actorId     String   @default("")
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Expense {
  id              String          @id @default(cuid())
  name            String
  categoryId      String?
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount          Float
  currency        String          @default("IQD")
  exchangeRate    Float           @default(1)
  /// Amount in IQD for reporting
  amountIqd       Float
  date            String
  /// one_time | recurring
  recurrence      String          @default("one_time")
  vendor          String          @default("")
  paymentMethod   String          @default("")
  description     String          @default("")
  attachmentUrl   String          @default("")
  notes           String          @default("")
  createdBy       String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([recurrence])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @default("root")
  actorLabel String   @default("root")
  action     String
  entityType String
  entityId   String   @default("")
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model AiInsight {
  id          String    @id @default(cuid())
  /// low_margin | stock | dead_stock | cost_increase | supplier | opportunity | profit | other
  kind        String
  /// critical | high | medium | low | info
  severity    String    @default("medium")
  titleAr     String
  titleEn     String
  bodyAr      String
  bodyEn      String
  whyAr       String    @default("")
  whyEn       String    @default("")
  evidenceJson Json     @default("{}")
  entityType  String    @default("")
  entityId    String    @default("")
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([severity, createdAt])
  @@index([kind, createdAt])
  @@index([dismissedAt])
}

/// —— MY VELORA: cards, referrals, journey, achievements ——

/// Global MY VELORA config (referral rewards, review rewards, feature flags)
model VeloraCardConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model VeloraCampaign {
  id         String   @id @default(cuid())
  slug       String   @unique
  nameAr     String
  nameEn     String
  startDate  String   @default("")
  endDate    String   @default("")
  configJson Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  templates VeloraCardTemplate[]

  @@index([isActive, startDate])
}

model VeloraCardTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameAr        String
  nameEn        String
  /// signature | soft-beauty | dark-luxury | editorial | brand-focus
  styleKey      String   @default("signature")
  backgroundUrl String   @default("")
  layoutJson    Json     @default("{}")
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  priority      Int      @default(0)
  campaignId    String?
  campaign      VeloraCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cards VeloraCard[]

  @@index([isActive, priority])
  @@index([styleKey])
}

model VeloraCard {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId       String?
  /// order | journey | achievement | unboxing | personality
  cardType      String   @default("order")
  templateId    String?
  template      VeloraCardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  styleKey      String   @default("signature")
  themeKey      String   @default("beauty-moment")
  status        String   @default("ready")
  payloadJson   Json     @default("{}")
  referralToken String   @unique
  pointsEarned  Int      @default(0)
  productCount  Int      @default(0)
  brandCount    Int      @default(0)
  viewedAt      DateTime?
  savedAt       DateTime?
  sharedAt      DateTime?
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        VeloraCardEvent[]
  referralLinks VeloraReferralLink[]
  reviews       VeloraOrderReview[]

  @@unique([customerId, orderId, cardType])
  @@index([customerId, generatedAt])
  @@index([orderId])
  @@index([referralToken])
}

model VeloraCardEvent {
  id        String     @id @default(cuid())
  cardId    String
  card      VeloraCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// view | save | share | style_change | instagram_share | referral_click
  eventType String
  metaJson  Json       @default("{}")
  createdAt DateTime   @default(now())

  @@index([cardId, createdAt])
  @@index([eventType, createdAt])
}

model VeloraReferralLink {
  id         String     @id @default(cuid())
  token      String     @unique
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cardId     String?
  card       VeloraCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())

  events VeloraReferralEvent[]

  @@index([customerId])
}

model VeloraReferralEvent {
  id             String           @id @default(cuid())
  referralLinkId String
  referralLink   VeloraReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  /// click | visit | registration | order | reward
  eventType      String
  visitorId      String           @default("")
  orderId        String           @default("")
  metaJson       Json             @default("{}")
  createdAt      DateTime         @default(now())

  @@index([referralLinkId, createdAt])
  @@index([eventType, createdAt])
}

model VeloraOrderReview {
  id                 String     @id @default(cuid())
  orderId            String
  customerId         String
  cardId             String?
  card               VeloraCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  rating             Int
  comment            String     @default("")
  productRatingsJson Json       @default("{}")
  photoUrl           String     @default("")
  pointsAwarded      Int        @default(0)
  createdAt          DateTime   @default(now())

  @@unique([orderId, customerId])
  @@index([customerId, createdAt])
}

model VeloraAchievement {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  achievementKey String
  unlockedAt     DateTime @default(now())
  sharedAt       DateTime?
  metaJson       Json     @default("{}")

  @@unique([customerId, achievementKey])
  @@index([customerId])
}
