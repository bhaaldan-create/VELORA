# Database — PostgreSQL (مطلوب)
# مثال محلي: postgresql://USER:PASSWORD@localhost:5432/velora?schema=public
# مثال Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Admin panel login
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# شفرة دخول إضافية لبوابة الإدارة (افتراضي AA2B12)
ADMIN_ACCESS_CODE=AA2B12

# Customer account sessions (optional; falls back to admin secret in dev)
CUSTOMER_SESSION_SECRET=

# ===== واتساب — إرسال رمز التحقق من رقم الشركة =====
WHATSAPP_COMPANY_PHONE=
# رقم واتساب الظاهر للزبائن في الواجهة (نفس رقم الشركة عادةً)
NEXT_PUBLIC_WHATSAPP_COMPANY_PHONE=
# Green API (من /admin/whatsapp)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# أو Cloud API / Webhook:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_WEBHOOK_URL=
# للتطوير فقط قبل الربط (يكشف OTP على الشاشة عند فشل الإرسال)
OTP_DEV_REVEAL=

# Order emails + OTP — Google Workspace SMTP (حساب orders@)
# App Password: https://myaccount.google.com/apppasswords (بحساب orders@)
ORDER_EMAIL_TO=orders@velorabeautyiq.me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@velorabeautyiq.me
SMTP_PASS=
MAIL_FROM=orders@velorabeautyiq.me
# اسم المرسل ثابت في الكود: VELORA Beauty (لا يظهر اسم حساب Google الشخصي)
# بديل: Google Apps Script webhook (إن لم تُفعّلي SMTP)
ORDER_WEBHOOK_URL=

# ===== الدفع الإلكتروني (Visa / Mastercard عبر Stripe) =====
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ===== Wayl — بوابة الدفع العراقية =====
# مفتاح التاجر من https://dashboard.thewayl.com (رأس X-WAYL-AUTHENTICATION)
WAYL_API_KEY=
# live أو test — في test تظهر البوابة بدون توثيق متجر؛ live يتطلب توثيق Wayl
WAYL_ENV=live
# سر توقيع Webhook (10–255 حرفاً — يُرسل عند إنشاء رابط الدفع)
WAYL_WEBHOOK_SECRET=
# فعّلي هذا فقط بعد موافقة Wayl على توثيق المتجر (وإلا ستفشل روابط الدفع بـ 403)
WAYL_STORE_VERIFIED=false
# اختياري — يُشتق تلقائياً من NEXT_PUBLIC_SITE_URL أو VERCEL_URL
# NEXT_PUBLIC_SITE_URL=https://velorabeautyiq.me
# Webhook URL في لوحة Wayl:
#   https://velorabeautyiq.me/api/payments/wayl/webhook

# ===== OAuth — تسجيل الدخول عبر Google / Apple =====
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized redirect URI:
#   https://velorabeautyiq.me/api/auth/oauth/google/callback
#   http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple Developer → Certificates, Identifiers & Profiles
# 1) App ID: beauty.velora.app (Sign in with Apple) — تم
# 2) Services ID → APPLE_CLIENT_ID (ليس Bundle ID!)
#    Return URL: https://velorabeautyiq.me/api/auth/oauth/apple/callback
# 3) Key (.p8) Sign in with Apple → APPLE_KEY_ID + مسار الملف محلياً
# 4) Team ID → APPLE_TEAM_ID
# محلي: ضع AuthKey_XXXX.p8 في secrets/ — لا ترفعه إلى Git
APPLE_CLIENT_ID=beauty.velora.app.web
APPLE_TEAM_ID=
APPLE_KEY_ID=4T6DD5Q83S
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_4T6DD5Q83S.p8
# Vercel فقط (في لوحة التحكم — ليس في الكود):
# APPLE_PRIVATE_KEY=

# عنوان الموقع العام (مهم لروابط OAuth على Vercel)
# NEXT_PUBLIC_SITE_URL=https://velorabeautyiq.me

# AI Advisor (optional)
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=

# ===== تطبيق الجوال (Capacitor) =====
# تطوير محلي على نفس الواي فاي:
# VELORA_MOBILE_URL=http://YOUR-LAN-IP:3000
# إنتاج (مطلوب قبل رفع المتاجر) — يجب HTTPS:
# VELORA_MOBILE_URL=https://your-domain.com
# بعد تغيير الرابط: npm run mobile:sync
# للإنتاج دفعة واحدة على Windows:
#   powershell -File scripts/mobile-set-production-url.ps1 -Url https://your-domain.com
VELORA_MOBILE_URL=
